// TimeDrift Database Schema
// Owner: Backend (BE-1)
// Based on docs/architecture/DATA_MODEL.md and docs/ba/P1_URD.md

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// In SQLite, enums are stored as text (Role: 'USER' | 'ADMIN', GenStatus: 'QUEUED' | 'RUNNING' | 'VALIDATING' | 'READY' | 'FAILED')

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  role            String    @default("USER") // "USER" | "ADMIN"
  isPro           Boolean   @default(false)
  proUntil        DateTime?
  proTransferCode String?   @unique
  locale          String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  playlists           Playlist[]
  paymentTransactions PaymentTransaction[]
}

model PaymentTransaction {
  id           String   @id @default(cuid())
  userId       String
  transferCode String
  amount       Int      @default(199000)
  rawNote      String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transferCode])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tag {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameEn    String
  nameVi    String
  music     Music[]
  scenes    Scene[]
  templates Template[]
}

model Music {
  id          String     @id @default(cuid())
  name        String
  type        String // see AUDIO_GUIDE §3 types: piano, ambient, acoustic, lofi, strings, etc.
  prompt      String
  seconds     Int // 30 | 45 | 60
  file        String? // storage path, e.g. storage/audio/m1.ogg
  durationSec Float?
  status      String     @default("QUEUED") // "QUEUED" | "RUNNING" | "VALIDATING" | "READY" | "FAILED"
  published   Boolean    @default(false)
  tags        Tag[]
  templates   Template[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Scene {
  id          String     @id @default(cuid())
  name        String
  description String
  prompt      String
  sourcePath  String?
  bundlePath  String?
  model       String? // LLM model that produced it
  status      String     @default("QUEUED") // "QUEUED" | "RUNNING" | "VALIDATING" | "READY" | "FAILED"
  published   Boolean    @default(false)
  isSeed      Boolean    @default(false)
  tags        Tag[]
  templates   Template[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  name      String
  musicId   String
  sceneId   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  music Music @relation(fields: [musicId], references: [id], onDelete: Restrict)
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  tags  Tag[]
}

model Playlist {
  id        String         @id @default(cuid())
  userId    String
  name      String
  items     PlaylistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  order      Int
  templateId String? // XOR (musicId + sceneId)
  musicId    String?
  sceneId    String?
  minutes    Int // 3..720
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, order])
}

model GenJob {
  id        String   @id @default(cuid())
  kind      String // "music" | "scene"
  targetId  String
  status    String   @default("QUEUED") // "QUEUED" | "RUNNING" | "VALIDATING" | "READY" | "FAILED"
  attempts  Int      @default(0)
  model     String?
  log       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, targetId])
}
